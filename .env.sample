# Ports
FRONT_PORT=3000
BACK_PORT=3001
DB_PORT=5433

# DB
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=nom_de_la_base

# Backend 
DATABASE_URL=postgres://user:password@db:5432/nom_de_la_base
# CLIENT_URL=http://your-pc-ip:3000 // Change this to your actual IP address if you want to access the backend from another device
CLIENT_URL=http://localhost:3000
JWT_SECRET=MySuperSecretKey
JWT_EXPIRES_IN=3600

# Front (public)
# NEXT_PUBLIC_API_URL=http://your-pc-ip:3001 // Change this to your actual IP address if you want to access the backend from another device
NEXT_PUBLIC_API_URL=http://localhost:3001