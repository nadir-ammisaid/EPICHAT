CLIENT_URL=http://localhost:3000

# Local database URL (backend launched from host)
DATABASE_URL=postgresql://user:password@localhost:5432/database_name?sslmode=disable
# Docker database URL (uncomment if needed)
# DATABASE_URL=postgresql://user:password@db:5432/database_name?sslmode=disable

JWT_SECRET=change-me
JWT_EXPIRES_IN=3600